import React, { useState } from 'react';
import {
  format,
  addMonths,
  subMonths,
  startOfMonth,
  endOfMonth,
  startOfWeek,
  endOfWeek,
  eachDayOfInterval,
  isSameMonth,
  isToday
} from 'date-fns';
import { ru } from 'date-fns/locale';
import { ChevronLeft, ChevronRight } from 'lucide-react';
import type { CycleStats, DayLog, PeriodCycle } from '../types';
import { formatDateKey, getCalendarDayInfo } from '../utils/cycleCalculations';

interface CalendarViewProps {
  cycles: PeriodCycle[];
  dayLogs: Record<string, DayLog>;
  stats: CycleStats;
  onSelectDate: (dateStr: string) => void;
}

export const CalendarView: React.FC<CalendarViewProps> = ({
  cycles,
  dayLogs,
  stats,
  onSelectDate
}) => {
  const [currentMonth, setCurrentMonth] = useState<Date>(new Date());

  const prevMonth = () => setCurrentMonth(subMonths(currentMonth, 1));
  const nextMonth = () => setCurrentMonth(addMonths(currentMonth, 1));
  const goToToday = () => setCurrentMonth(new Date());

  const monthStart = startOfMonth(currentMonth);
  const monthEnd = endOfMonth(monthStart);
  const calendarStart = startOfWeek(monthStart, { weekStartsOn: 1 });
  const calendarEnd = endOfWeek(monthEnd, { weekStartsOn: 1 });

  const calendarDays = eachDayOfInterval({
    start: calendarStart,
    end: calendarEnd
  });

  const weekDayNames = ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Вс'];

  return (
    <div className="bg-white rounded-3xl p-5 border border-blush-200/80 shadow-soft max-w-md mx-auto">
      <div className="flex items-center justify-between mb-4">
        <div>
          <h2 className="text-lg font-bold text-slate-800 capitalize">
            {format(currentMonth, 'LLLL yyyy', { locale: ru })}
          </h2>
          <button
            onClick={goToToday}
            className="text-[11px] text-blush-600 font-semibold hover:underline"
          >
            Сегодня
          </button>
        </div>

        <div className="flex items-center space-x-1.5">
          <button
            onClick={prevMonth}
            className="p-2 rounded-xl bg-slate-50 hover:bg-blush-50 text-slate-600 hover:text-blush-600 transition-colors"
            title="Предыдущий месяц"
          >
            <ChevronLeft className="w-5 h-5" />
          </button>
          <button
            onClick={nextMonth}
            className="p-2 rounded-xl bg-slate-50 hover:bg-blush-50 text-slate-600 hover:text-blush-600 transition-colors"
            title="Следующий месяц"
          >
            <ChevronRight className="w-5 h-5" />
          </button>
        </div>
      </div>

      <div className="grid grid-cols-7 gap-1 text-center mb-2">
        {weekDayNames.map((name, i) => (
          <div
            key={name}
            className={`text-xs font-semibold py-1 ${
              i >= 5 ? 'text-rosewood-400' : 'text-slate-400'
            }`}
          >
            {name}
          </div>
        ))}
      </div>

      <div className="grid grid-cols-7 gap-1">
        {calendarDays.map((day) => {
          const dateKey = formatDateKey(day);
          const isCurrentMonthDay = isSameMonth(day, currentMonth);
          const isCurrentToday = isToday(day);

          const {
            isPeriod,
            isPredictedPeriod,
            isOvulation,
            isFertile,
            hasLog,
            flowIntensity
          } = getCalendarDayInfo(day, cycles, dayLogs, stats);

          let bgClass = 'bg-transparent text-slate-700 hover:bg-blush-50/70';
          let borderClass = 'border-transparent';

          if (isPeriod) {
            bgClass = 'bg-gradient-to-tr from-blush-500 to-blush-600 text-white font-bold shadow-xs';
          } else if (isPredictedPeriod) {
            bgClass = 'bg-blush-50 text-blush-700 font-medium border-dashed border border-blush-300';
          } else if (isOvulation) {
            bgClass = 'bg-lavender-100 text-lavender-900 font-bold border border-lavender-300';
          } else if (isFertile) {
            bgClass = 'bg-sage-50 text-emerald-800';
          }

          if (isCurrentToday && !isPeriod) {
            borderClass = 'ring-2 ring-blush-400 ring-offset-1';
          }

          if (!isCurrentMonthDay) {
            bgClass = 'bg-transparent text-slate-300 opacity-40';
          }

          return (
            <button
              key={dateKey}
              onClick={() => onSelectDate(dateKey)}
              className={`h-11 rounded-2xl flex flex-col items-center justify-center relative transition-all active:scale-95 ${bgClass} ${borderClass}`}
            >
              <span className="text-xs leading-none">
                {format(day, 'd')}
              </span>

              <div className="flex items-center space-x-0.5 mt-1 h-1.5">
                {isOvulation && (
                  <span className="w-1.5 h-1.5 rounded-full bg-lavender-500" />
                )}
                {hasLog && !isPeriod && (
                  <span className="w-1.5 h-1.5 rounded-full bg-amber-400" />
                )}
                {isPeriod && flowIntensity && (
                  <span className="w-1 h-1 rounded-full bg-white opacity-80" />
                )}
              </div>
            </button>
          );
        })}
      </div>

      <div className="mt-5 pt-4 border-t border-slate-100 grid grid-cols-2 gap-2 text-[11px] text-slate-600">
        <div className="flex items-center space-x-2">
          <span className="w-3.5 h-3.5 rounded-md bg-gradient-to-tr from-blush-500 to-blush-600 shadow-xs" />
          <span>Месячные</span>
        </div>
        <div className="flex items-center space-x-2">
          <span className="w-3.5 h-3.5 rounded-md bg-blush-50 border border-dashed border-blush-300" />
          <span>Прогноз месячных</span>
        </div>
        <div className="flex items-center space-x-2">
          <span className="w-3.5 h-3.5 rounded-md bg-lavender-100 border border-lavender-300" />
          <span>День овуляции</span>
        </div>
        <div className="flex items-center space-x-2">
          <span className="w-3.5 h-3.5 rounded-md bg-sage-50 border border-sage-200" />
          <span>Окно фертильности</span>
        </div>
        <div className="flex items-center space-x-2 col-span-2">
          <span className="w-2 h-2 rounded-full bg-amber-400" />
          <span>Есть заметки или симптомы</span>
        </div>
      </div>
    </div>
  );
};
</file>

<file path="src/components/CycleRing.tsx">
import React from 'react';
import { Droplet, Calendar } from 'lucide-react';
import confetti from 'canvas-confetti';
import type { CycleStats } from '../types';

interface CycleRingProps {
  stats: CycleStats;
  isPeriodActive: boolean;
  onTogglePeriod: () => void;
  onOpenCalendar: () => void;
}

export const CycleRing: React.FC<CycleRingProps> = ({
  stats,
  isPeriodActive,
  onTogglePeriod,
  onOpenCalendar
}) => {
  const {
    currentCycleDay,
    currentPhase,
    phaseTitle,
    phaseDescription,
    daysUntilNextPeriod,
    isDelay,
    delayDays,
    pregnancyChance,
    avgCycleLength
  } = stats;

  const handlePeriodAction = () => {
    if (!isPeriodActive) {
      confetti({
        particleCount: 30,
        spread: 70,
        origin: { y: 0.6 },
        colors: ['#f43f5e', '#fda4af', '#fecdd3']
      });
    }
    onTogglePeriod();
  };

  const phaseColors = {
    menstrual: {
      ring: 'from-blush-400 to-blush-600',
      badgeBg: 'bg-blush-100 text-blush-700 border-blush-200',
      heroAccent: 'text-blush-600',
      glow: 'shadow-[0_0_40px_rgba(244,67,105,0.18)]'
    },
    follicular: {
      ring: 'from-peach-300 to-peach-500',
      badgeBg: 'bg-peach-100 text-peach-700 border-peach-200',
      heroAccent: 'text-peach-600',
      glow: 'shadow-[0_0_40px_rgba(255,155,109,0.18)]'
    },
    ovulation: {
      ring: 'from-lavender-400 to-blush-400',
      badgeBg: 'bg-lavender-100 text-lavender-700 border-lavender-200',
      heroAccent: 'text-lavender-600',
      glow: 'shadow-[0_0_40px_rgba(189,150,225,0.22)]'
    },
    luteal: {
      ring: 'from-rosewood-300 to-blush-400',
      badgeBg: 'bg-rosewood-100 text-rosewood-700 border-rosewood-200',
      heroAccent: 'text-rosewood-600',
      glow: 'shadow-[0_0_40px_rgba(197,132,118,0.18)]'
    }
  }[currentPhase];

  const progressPercent = Math.min(100, Math.round((currentCycleDay / (avgCycleLength || 28)) * 100));
  const radius = 100;
  const circumference = 2 * Math.PI * radius;
  const strokeDashoffset = circumference - (progressPercent / 100) * circumference;

  return (
    <div className="flex flex-col items-center">
      <div className="relative w-64 h-64 sm:w-72 sm:h-72 flex items-center justify-center my-4">
        <div className={`absolute inset-4 rounded-full bg-white ${phaseColors.glow} border border-blush-100/60 transition-all duration-700`} />

        <svg className="w-full h-full -rotate-90 transform" viewBox="0 0 240 240">
          <circle
            cx="120"
            cy="120"
            r={radius}
            stroke="#fce7ea"
            strokeWidth="10"
            fill="transparent"
            strokeLinecap="round"
          />
          <circle
            cx="120"
            cy="120"
            r={radius}
            stroke="url(#gradient)"
            strokeWidth="10"
            fill="transparent"
            strokeDasharray={circumference}
            strokeDashoffset={strokeDashoffset}
            strokeLinecap="round"
            className="transition-all duration-1000 ease-out"
          />
          <defs>
            <linearGradient id="gradient" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stopColor="#ff7e95" />
              <stop offset="100%" stopColor="#f44369" />
            </linearGradient>
          </defs>
        </svg>

        <div className="absolute inset-0 flex flex-col items-center justify-center p-6 text-center select-none">
          <span
            className={`px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider border mb-1.5 transition-colors ${phaseColors.badgeBg}`}
          >
            {phaseTitle}
          </span>

          <div className="flex items-baseline space-x-1">
            <span className="text-4xl sm:text-5xl font-black text-slate-800 tracking-tight">
              {currentCycleDay}
            </span>
            <span className="text-sm font-semibold text-slate-400">день</span>
          </div>

          <div className="mt-1">
            {isPeriodActive ? (
              <span className="text-xs font-medium text-blush-600 flex items-center justify-center space-x-1">
                <Droplet className="w-3.5 h-3.5 fill-blush-500 text-blush-500 animate-bounce" />
                <span>Идут месячные</span>
              </span>
            ) : isDelay ? (
              <span className="text-xs font-semibold text-amber-600">
                Задержка {delayDays} {delayDays === 1 ? 'день' : delayDays < 5 ? 'дня' : 'дней'}
              </span>
            ) : daysUntilNextPeriod === 0 ? (
              <span className="text-xs font-semibold text-blush-600">Ожидаются сегодня</span>
            ) : (
              <span className="text-xs font-medium text-slate-500">
                До месячных: <strong className="text-slate-700 font-semibold">{daysUntilNextPeriod} дн.</strong>
              </span>
            )}
          </div>

          <div className="mt-2 text-[11px] px-2.5 py-0.5 rounded-full bg-slate-50 border border-slate-200/60 text-slate-500 font-medium">
            Шанс зачатия:{' '}
            <span
              className={
                pregnancyChance === 'Пик овуляции' || pregnancyChance === 'Высокая'
                  ? 'text-blush-600 font-bold'
                  : 'text-slate-700'
              }
            >
              {pregnancyChance}
            </span>
          </div>
        </div>
      </div>

      <p className="text-center text-xs sm:text-sm text-slate-500 max-w-xs mb-5 px-4 leading-relaxed">
        {phaseDescription}
      </p>

      <div className="w-full max-w-sm flex items-center space-x-2.5 px-4">
        <button
          onClick={handlePeriodAction}
          className={`flex-1 py-3.5 px-4 rounded-2xl font-semibold text-sm flex items-center justify-center space-x-2 shadow-soft transition-all active:scale-95 ${
            isPeriodActive
              ? 'bg-white border-2 border-blush-400 text-blush-600 hover:bg-blush-50'
              : 'bg-gradient-to-r from-blush-500 to-blush-600 text-white hover:brightness-105'
          }`}
        >
          <Droplet
            className={`w-4 h-4 ${isPeriodActive ? 'fill-blush-500' : 'fill-white'}`}
          />
          <span>{isPeriodActive ? 'Завершить месячные' : 'Отметить месячные'}</span>
        </button>

        <button
          onClick={onOpenCalendar}
          className="p-3.5 rounded-2xl bg-white border border-blush-200 text-slate-700 shadow-soft hover:bg-blush-50/50 transition-all active:scale-95"
          title="Открыть календарь"
        >
          <Calendar className="w-5 h-5 text-blush-600" />
        </button>
      </div>
    </div>
  );
};
</file>

<file path="src/components/DailyCard.tsx">
import React, { useState } from 'react';
import { Sparkles, Heart, Compass, Smile } from 'lucide-react';
import confetti from 'canvas-confetti';
import { getDailyAffirmation, PHASE_SPECIFIC_TIPS } from '../utils/affirmations';
import type { CyclePhase } from '../types';

interface DailyCardProps {
  currentPhase: CyclePhase;
}

export const DailyCard: React.FC<DailyCardProps> = ({ currentPhase }) => {
  const [seedOffset, setSeedOffset] = useState<number>(0);
  const [activeTab, setActiveTab] = useState<'compliment' | 'prediction' | 'care'>('compliment');

  const message = getDailyAffirmation(undefined, seedOffset);
  const phaseTip = PHASE_SPECIFIC_TIPS[currentPhase];

  const handleNextMessage = (e: React.MouseEvent) => {
    e.stopPropagation();
    setSeedOffset((prev) => prev + 1);

    confetti({
      particleCount: 25,
      spread: 60,
      origin: { y: 0.3 },
      colors: ['#ff7e95', '#ffd6dc', '#ffc1a1', '#d7beed'],
      ticks: 120,
      gravity: 0.8,
      scalar: 0.8
    });
  };

  return (
    <div className="bg-gradient-to-br from-white via-blush-50/70 to-peach-50/50 rounded-3xl p-5 border border-blush-200/80 shadow-soft relative overflow-hidden transition-all duration-300">
      <div className="absolute -right-6 -bottom-6 w-28 h-28 rounded-full bg-blush-200/40 blur-2xl pointer-events-none" />
      <div className="absolute -left-6 -top-6 w-24 h-24 rounded-full bg-peach-200/30 blur-2xl pointer-events-none" />

      <div className="flex items-center justify-between mb-3.5 relative z-10">
        <div className="flex items-center space-x-2">
          <span className="text-lg">{message.icon}</span>
          <span className="text-xs font-semibold tracking-wider uppercase text-blush-600">
            Послание дня
          </span>
        </div>

        <button
          onClick={handleNextMessage}
          className="group flex items-center space-x-1.5 px-2.5 py-1 rounded-full bg-white/90 border border-blush-200 text-xs text-blush-700 font-medium hover:bg-blush-100/60 transition-all active:scale-95 shadow-xs"
          title="Получить другое предсказание"
        >
          <Sparkles className="w-3.5 h-3.5 text-blush-500 group-hover:rotate-12 transition-transform" />
          <span>Ещё</span>
        </button>
      </div>

      <div className="flex space-x-1 p-1 bg-white/80 backdrop-blur-xs rounded-xl border border-blush-100 mb-3 relative z-10">
        <button
          onClick={() => setActiveTab('compliment')}
          className={`flex-1 flex items-center justify-center space-x-1 py-1.5 rounded-lg text-xs font-medium transition-all ${
            activeTab === 'compliment'
              ? 'bg-blush-500 text-white shadow-xs'
              : 'text-slate-600 hover:text-blush-600'
          }`}
        >
          <Heart className="w-3 h-3" />
          <span>Комплимент</span>
        </button>

        <button
          onClick={() => setActiveTab('prediction')}
          className={`flex-1 flex items-center justify-center space-x-1 py-1.5 rounded-lg text-xs font-medium transition-all ${
            activeTab === 'prediction'
              ? 'bg-blush-500 text-white shadow-xs'
              : 'text-slate-600 hover:text-blush-600'
          }`}
        >
          <Compass className="w-3 h-3" />
          <span>Предсказание</span>
        </button>

        <button
          onClick={() => setActiveTab('care')}
          className={`flex-1 flex items-center justify-center space-x-1 py-1.5 rounded-lg text-xs font-medium transition-all ${
            activeTab === 'care'
              ? 'bg-blush-500 text-white shadow-xs'
              : 'text-slate-600 hover:text-blush-600'
          }`}
        >
          <Smile className="w-3 h-3" />
          <span>Забота</span>
        </button>
      </div>

      <div className="relative z-10 min-h-[72px] flex items-center">
        {activeTab === 'compliment' && (
          <p className="text-slate-700 text-sm sm:text-base font-normal leading-relaxed italic animate-fade-in">
            «{message.compliment}»
          </p>
        )}

        {activeTab === 'prediction' && (
          <div className="space-y-1 animate-fade-in">
            <p className="text-slate-700 text-sm sm:text-base font-normal leading-relaxed">
              ✨ {message.prediction}
            </p>
          </div>
        )}

        {activeTab === 'care' && (
          <div className="space-y-1 animate-fade-in">
            <div className="flex items-center space-x-1.5 text-xs font-semibold text-rosewood-700">
              <span>{phaseTip.icon}</span>
              <span>{phaseTip.title}</span>
            </div>
            <p className="text-slate-600 text-xs sm:text-sm leading-relaxed">
              {phaseTip.hint}
            </p>
          </div>
        )}
      </div>
    </div>
  );
};
</file>

<file path="src/components/DayLogModal.tsx">
import React, { useState, useEffect } from 'react';
import { X, Droplet, Trash2, Check } from 'lucide-react';
import type { DayLog, FlowIntensity, MoodType, SexActivity, SymptomType } from '../types';
import { formatReadableDate } from '../utils/cycleCalculations';

interface DayLogModalProps {
  dateStr: string | null;
  initialLog?: DayLog;
  onClose: () => void;
  onSave: (log: DayLog) => Promise<void>;
  onDelete: (dateStr: string) => Promise<void>;
}

const SYMPTOM_OPTIONS: { id: SymptomType; label: string; icon: string }[] = [
  { id: 'cramps', label: 'Спазмы', icon: '⚡' },
  { id: 'headache', label: 'Головная боль', icon: '🤕' },
  { id: 'tender_breasts', label: 'Грудь', icon: '🍈' },
  { id: 'bloating', label: 'Вздутие', icon: '🎈' },
  { id: 'fatigue', label: 'Усталость', icon: '😴' },
  { id: 'backache', label: 'Поясница', icon: '🧘‍♀️' },
  { id: 'acne', label: 'Высыпания', icon: '✨' },
  { id: 'cravings', label: 'Тяга к сладкому', icon: '🍫' },
  { id: 'nausea', label: 'Тошнота', icon: '🤢' },
  { id: 'insomnia', label: 'Бессонница', icon: '🌙' },
];

const MOOD_OPTIONS: { id: MoodType; label: string; icon: string }[] = [
  { id: 'happy', label: 'Радостное', icon: '🥰' },
  { id: 'calm', label: 'Спокойное', icon: '😌' },
  { id: 'energetic', label: 'Энергичное', icon: '⚡' },
  { id: 'romantic', label: 'Романтичное', icon: '💖' },
  { id: 'sensitive', label: 'Ранимое', icon: '🥺' },
  { id: 'irritated', label: 'Раздраженное', icon: '😤' },
  { id: 'anxious', label: 'Тревожное', icon: '😰' },
  { id: 'sad', label: 'Грустное', icon: '🌧️' },
];

const FLOW_OPTIONS: { id: FlowIntensity; label: string; drops: number }[] = [
  { id: 'none', label: 'Нет', drops: 0 },
  { id: 'spotting', label: 'Мажущие', drops: 1 },
  { id: 'light', label: 'Легкие', drops: 2 },
  { id: 'medium', label: 'Средние', drops: 3 },
  { id: 'heavy', label: 'Обильные', drops: 4 },
];

const SEX_OPTIONS: { id: SexActivity; label: string; icon: string }[] = [
  { id: 'none', label: 'Не было', icon: '✕' },
  { id: 'protected', label: 'С защитой', icon: '🛡️' },
  { id: 'unprotected', label: 'Без защиты', icon: '❤️' },
  { id: 'high_libido', label: 'Высокое либидо', icon: '🔥' },
];

export const DayLogModal: React.FC<DayLogModalProps> = ({
  dateStr,
  initialLog,
  onClose,
  onSave,
  onDelete
}) => {
  if (!dateStr) return null;

  const [isPeriod, setIsPeriod] = useState<boolean>(initialLog?.isPeriod || false);
  const [flow, setFlow] = useState<FlowIntensity>(initialLog?.flowIntensity || 'none');
  const [symptoms, setSymptoms] = useState<SymptomType[]>(initialLog?.symptoms || []);
  const [moods, setMoods] = useState<MoodType[]>(initialLog?.moods || []);
  const [sex, setSex] = useState<SexActivity>(initialLog?.sexActivity || 'none');
  const [notes, setNotes] = useState<string>(initialLog?.notes || '');
  const [isSaving, setIsSaving] = useState(false);

  useEffect(() => {
    setIsPeriod(initialLog?.isPeriod || false);
    setFlow(initialLog?.flowIntensity || (initialLog?.isPeriod ? 'medium' : 'none'));
    setSymptoms(initialLog?.symptoms || []);
    setMoods(initialLog?.moods || []);
    setSex(initialLog?.sexActivity || 'none');
    setNotes(initialLog?.notes || '');
  }, [initialLog, dateStr]);

  const toggleSymptom = (sym: SymptomType) => {
    setSymptoms((prev) =>
      prev.includes(sym) ? prev.filter((s) => s !== sym) : [...prev, sym]
    );
  };

  const toggleMood = (m: MoodType) => {
    setMoods((prev) =>
      prev.includes(m) ? prev.filter((item) => item !== m) : [...prev, m]
    );
  };

  const handleFlowSelect = (selected: FlowIntensity) => {
    setFlow(selected);
    if (selected === 'none') {
      setIsPeriod(false);
    } else {
      setIsPeriod(true);
    }
  };

  const handleSave = async () => {
    setIsSaving(true);
    const newLog: DayLog = {
      date: dateStr,
      isPeriod: isPeriod || flow !== 'none',
      flowIntensity: flow,
      symptoms,
      moods,
      sexActivity: sex,
      notes: notes.trim(),
      updatedAt: Date.now()
    };

    await onSave(newLog);
    setIsSaving(false);
    onClose();
  };

  const handleDelete = async () => {
    if (window.confirm('Очистить запись за этот день?')) {
      setIsSaving(true);
      await onDelete(dateStr);
      setIsSaving(false);
      onClose();
    }
  };

  return (
    <div className="fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-slate-900/40 backdrop-blur-xs p-0 sm:p-4 animate-fade-in">
      <div className="w-full sm:max-w-lg bg-white rounded-t-3xl sm:rounded-3xl max-h-[90vh] flex flex-col shadow-2xl overflow-hidden border border-blush-100">
        <div className="p-4 sm:p-5 border-b border-slate-100 flex items-center justify-between bg-gradient-to-r from-blush-50/50 to-white">
          <div>
            <span className="text-[11px] font-semibold tracking-wider uppercase text-blush-600">
              Запись за день
            </span>
            <h3 className="text-base sm:text-lg font-bold text-slate-800 capitalize">
              {formatReadableDate(dateStr, 'EEEE, d MMMM')}
            </h3>
          </div>
          <button
            onClick={onClose}
            className="p-2 rounded-full hover:bg-slate-100 text-slate-400 hover:text-slate-600 transition-colors"
          >
            <X className="w-5 h-5" />
          </button>
        </div>

        <div className="p-4 sm:p-6 overflow-y-auto space-y-5">
          <div className="bg-blush-50/50 rounded-2xl p-3.5 border border-blush-100">
            <div className="flex items-center justify-between mb-2.5">
              <span className="text-xs font-bold text-slate-700 flex items-center space-x-1.5">
                <Droplet className="w-4 h-4 text-blush-500 fill-blush-500" />
                <span>Выделения / Месячные</span>
              </span>
            </div>
            <div className="grid grid-cols-5 gap-1.5">
              {FLOW_OPTIONS.map((item) => (
                <button
                  key={item.id}
                  type="button"
                  onClick={() => handleFlowSelect(item.id)}
                  className={`py-2 px-1 rounded-xl text-xs font-medium flex flex-col items-center justify-center transition-all ${
                    flow === item.id
                      ? 'bg-blush-500 text-white shadow-xs'
                      : 'bg-white text-slate-600 border border-slate-200/80 hover:border-blush-300'
                  }`}
                >
                  <span className="text-[10px] opacity-80 mb-0.5">
                    {item.drops === 0 ? '✕' : '💧'.repeat(item.drops)}
                  </span>
                  <span className="text-[11px]">{item.label}</span>
                </button>
              ))}
            </div>
          </div>

          <div>
